{
  "schema": "iberfit.exercise.media.autowire-input.v2",
  "identity": {
    "authoritative_field": "exercise_id",
    "matching": "exact",
    "slug_authoritative": false,
    "display_name_authoritative": false
  },
  "required": ["exercise_id", "media"],
  "media_contract": {
    "schema": "iberfit.exercise.visual.v1",
    "style": "iberfit-premium-movement-pair-v1",
    "bucket": "iberfit-exercise-media",
    "required_asset": "movement",
    "visual_system": {
      "version": "iberfit.exercise.media.system.v1",
      "aspect_ratio": "4:5",
      "generation_master": {
        "min_width": 1280,
        "min_height": 1600,
        "allow_upscale_from_delivery": false
      },
      "delivery": {
        "width": 640,
        "height": 800,
        "format": "webp"
      },
      "safe_area_percent": 6,
      "embedded_text": false,
      "exercise_name_in_pixels": false,
      "technical_copy_in_pixels": false,
      "phase_labels_in_pixels": false,
      "branding": {
        "official_isotipo_only": true,
        "shirt_only": true,
        "wordmark": false,
        "generated_branding": false
      },
      "anatomy_inset": {
        "required_by_default": true,
        "exception_requires_qa_justification": true,
        "text_labels": false,
        "zone": "upper",
        "preferred_corner": "upper-right",
        "width_percent_min": 16,
        "width_percent_max": 22,
        "primary_muscle_color": "iberfit-technical-green",
        "secondary_muscle_color": "iberfit-restrained-gold",
        "remaining_anatomy": "neutral-cream-grey-low-contrast",
        "must_not_obscure_biomechanics": true
      },
      "contexts": [
        "library-card",
        "client-live-session",
        "coach-live-session",
        "exercise-detail",
        "fullscreen-viewer"
      ]
    },
    "publication_requirements": {
      "qa.biomechanics": "approved",
      "qa.visual": "approved",
      "published": true,
      "visibility": "clientVisible=true or coachVisible=true"
    }
  },
  "fail_closed": [
    "invalid canonical exercise id",
    "duplicate canonical exercise id",
    "missing or invalid exercise_id",
    "duplicate media exercise_id",
    "unknown media exercise_id",
    "invalid canonical visual manifest",
    "asset path outside its canonical exercise_id namespace"
  ]
}
